# Backend (required) — Railway Postgres connection string (auto-injected when you attach a Postgres plugin)
DATABASE_URL=postgresql://user:password@host:port/database

# Backend (required) — secret used to sign/verify auth JWTs. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Backend (required) — for AI insight generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Bright Data MCP (optional - falls back to direct fetch)
BRIGHTDATA_MCP_TOKEN=
# BRIGHTDATA_MCP_URL=https://mcp.brightdata.com/mcp?token=YOUR_TOKEN

# Bright Data Proxy (optional fallback)
BRIGHTDATA_PROXY_HOST=
BRIGHTDATA_PROXY_PORT=22225
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=

# Acontext (optional - falls back to in-memory)
ACONTEXT_API_URL=https://api.acontext.ai/v1
ACONTEXT_API_KEY=

# ActionBook (optional - fallback scraper)
ACTIONBOOK_API_URL=https://api.actionbook.io/v1
ACTIONBOOK_API_KEY=

# SMTP (optional - falls back to no-op if unset) — sends an alert email when a
# scan detects a significant (>=5%) pricing change
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Server
PORT=3001

# Backend — allow the deployed frontend's origin (Railway service URL)
FRONTEND_URL=https://your-frontend.up.railway.app

# Frontend (required) — points at the deployed backend Railway service
# VITE_API_URL=http://localhost:3001/api

# Optional: Relax scan limit for demos (50/hour instead of 20)
# DEMO_MODE=true
